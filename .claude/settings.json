{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 cli.py *)",
      "Bash(python3 -m pytest*)",
      "Bash(pip install -e*)",
      "Bash(./gradlew *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] || exit 0; python3 -c 'import pytest' >/dev/null 2>&1 || python3 -m pip install -q 'pytest>=8' >/dev/null 2>&1 || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
