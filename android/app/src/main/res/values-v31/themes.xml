<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: background only; the AgSoft splash is drawn by Compose right after (ADR-0009). -->
    <style name="Theme.QuarkCosmos" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/qc_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/qc_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
</resources>
